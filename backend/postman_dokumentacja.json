{
    "info": {
        "name": "ShoppingHaul API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:5001"
        },
        {
            "key": "token",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Autoryzacja",
            "item": [
                {
                    "name": "Rejestracja",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"haslo123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "register"
                            ]
                        }
                    }
                },
                {
                    "name": "Logowanie",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"haslo123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "Refresh Token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"refreshToken\": \"wklej_refresh_token\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/refresh",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "refresh"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Produkty",
            "item": [
                {
                    "name": "Pobierz wszystkie produkty",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/products",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "products"
                            ]
                        }
                    }
                },
                {
                    "name": "Pobierz produkt po ID",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/products?id=1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "products"
                            ],
                            "query": [
                                {
                                    "key": "id",
                                    "value": "1"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Filtruj produkty",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/products?minPrice=100&maxPrice=500&categories=Buty",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "products"
                            ],
                            "query": [
                                {
                                    "key": "minPrice",
                                    "value": "100"
                                },
                                {
                                    "key": "maxPrice",
                                    "value": "500"
                                },
                                {
                                    "key": "categories",
                                    "value": "Buty"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Dodaj produkt",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Nowy Produkt\",\n    \"price\": 199.99,\n    \"category\": \"Buty\",\n    \"description\": \"Opis produktu\",\n    \"imageURL\": \"https://example.com/image.jpg\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/products",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "products"
                            ]
                        }
                    }
                },
                {
                    "name": "Usun produkt",
                    "request": {
                        "method": "DELETE",
                        "url": {
                            "raw": "{{baseUrl}}/products/1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "products",
                                "1"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Koszyk",
            "item": [
                {
                    "name": "Pobierz koszyk",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/cart",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "cart"
                            ]
                        }
                    }
                },
                {
                    "name": "Dodaj do koszyka",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"productId\": 1,\n    \"quantity\": 2\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/cart",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "cart"
                            ]
                        }
                    }
                },
                {
                    "name": "Zmien ilosc w koszyku",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"quantity\": 3\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/cart/1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "cart",
                                "1"
                            ]
                        }
                    }
                },
                {
                    "name": "Usun z koszyka",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/cart/1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "cart",
                                "1"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Opinie",
            "item": [
                {
                    "name": "Pobierz opinie produktu",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/reviews?productID=1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "reviews"
                            ],
                            "query": [
                                {
                                    "key": "productID",
                                    "value": "1"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Pobierz wszystkie opinie",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/reviews/all",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "reviews",
                                "all"
                            ]
                        }
                    }
                },
                {
                    "name": "Dodaj opinie",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"productId\": 1,\n    \"stars\": 5,\n    \"description\": \"Swietny produkt!\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/reviews",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "reviews"
                            ]
                        }
                    }
                },
                {
                    "name": "Usun opinie",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/reviews/1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "reviews",
                                "1"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Zamowienia",
            "item": [
                {
                    "name": "Pobierz historie zamowien",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/orders",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "orders"
                            ]
                        }
                    }
                },
                {
                    "name": "Pobierz szczegoly zamowienia",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/orders/1",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "orders",
                                "1"
                            ]
                        }
                    }
                },
                {
                    "name": "Zloz zamowienie (checkout)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/orders",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "orders"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}